# Backend base URLs. Copy to .env.local and adjust as needed.

# Servio dispatch-intake API (voice/text/photo classification + chat, REST + WebSocket).
NEXT_PUBLIC_SERVIO_API_BASE=http://localhost:8000
NEXT_PUBLIC_SERVIO_WS_BASE=ws://localhost:8000

# Provider Match API (ranking, providers, bandit dashboard, auth).
# The bandit WebSocket URL is derived from this by swapping http -> ws.
NEXT_PUBLIC_MATCH_API_BASE=http://localhost:8001
