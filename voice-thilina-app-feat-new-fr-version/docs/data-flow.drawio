        </mxCell>

        <!-- ===== LANE 1: FRONTEND ===== -->
        <mxCell id="n_f0" value="page.tsx&#10;Pick / create case&#10;(listChats, createChat)&#10;→ activeChatId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="240" height="90" as="geometry" />
