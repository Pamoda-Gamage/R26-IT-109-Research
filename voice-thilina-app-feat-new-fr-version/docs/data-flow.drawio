          <mxGeometry x="2280" y="110" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_f4" value="VoiceRecorder.tsx&#10;Bubble renders:&#10;content (EN) + translation (SI)&#10;+ ClassificationBadge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2560" y="110" width="260" height="100" as="geometry" />
        </mxCell>
