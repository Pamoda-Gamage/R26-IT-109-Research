        <mxCell id="title" value="Dispatch Voice App — End-to-End Data Flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2900" height="34" as="geometry" />
        </mxCell>

        <!-- Lane headers -->
        <mxCell id="lane1" value="1. FRONTEND — React / Next.js  (VoiceRecorder.tsx, Usechatsession.tsx, ChatHero.tsx, Classificationbadge.tsx, page.tsx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=16;fontStyle=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="2900" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="2. BACKEND REST — routers/chats.py  (create Message, optimistic broadcast, queue background task)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;fontSize=16;fontStyle=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="360" width="2900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="3. AI SERVICES — Gemini transcribe / translate / vision  +  local sklearn classifiers (predict_service.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=16;fontStyle=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="580" width="2900" height="340" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="4. DISPATCH ORCHESTRATION — dispatch_service.py  (classification decision + bilingual EN/SI reply)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;fontSize=16;fontStyle=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="940" width="2900" height="800" as="geometry" />
        </mxCell>
        <mxCell id="lane5" value="5. DATA STORE &amp; WEBSOCKET BROADCAST — models.py  +  connection_manager.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontSize=16;fontStyle=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
