          <mxGeometry x="600" y="410" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_b2" value="background_tasks.add_task(&#10;process_text/audio/image_message)&#10;returns {message_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
